# ===== Banco de dados (MySQL via PyMySQL) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aegis
DB_PASSWORD=troque-esta-senha
DB_NAME=aegis_lpr
# DATABASE_URL=sqlite:///./aegis.db   # opcional: sobrescreve as variáveis acima (útil em desenvolvimento)

# ===== Segurança =====
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"  (mínimo 32 caracteres)
JWT_SECRET_KEY=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
TOKEN_EXPIRA_MINUTOS=60
TOKEN_PRIMEIRO_ACESSO_MINUTOS=15
LOGIN_MAX_FALHAS=5
LOGIN_JANELA_SEGUNDOS=300
# Chave que a câmera/listener LPR envia no header X-Camera-Key
CAMERA_API_KEY=gere-uma-chave-para-a-camera
# Aceita apenas clientes da rede local (loopback e faixas privadas)
SOMENTE_LAN=true
# REDES_PERMITIDAS=100.64.0.0/10          # faixas extras (ex.: VPN), separadas por vírgula
# CORS_ORIGINS=http://192.168.0.20:3000   # origens do front-end/app, separadas por vírgula

# ===== Super ADM inicial (criado na primeira execução; troca de senha obrigatória) =====
SUPER_ADMIN_NOME=Super Administrador
SUPER_ADMIN_EMAIL=admin@condominio.local
SUPER_ADMIN_CPF=00000000000
SUPER_ADMIN_SENHA_INICIAL=Trocar@123

# ===== E-mail (senha temporária de novos usuários) =====
# console = apenas registra no log (DESENVOLVIMENTO); smtp = envia de verdade
EMAIL_MODO=console
SMTP_HOST=smtp.exemplo.local
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMETENTE=aegis@condominio.local

# ===== Regras de acesso =====
MAX_VISITANTES_POR_MORADOR=2
JOB_LIMPEZA_ATIVO=true
JOB_LIMPEZA_HORARIO=03:00

# ===== Relé do portão =====
# simulado = só registra no log | http = envia pulso ao microcontrolador na LAN
RELE_MODO=simulado
# RELE_URL=http://192.168.0.50/portao
# RELE_TOKEN=token-do-microcontrolador
RELE_PULSO_MS=3000
RELE_TIMEOUT_S=2

# ===== Reconhecimento de placas =====
YOLO_MODEL_PATH=modelos/placa.pt
YOLO_CONFIANCA_MINIMA=0.35
OCR_CONFIANCA_MINIMA=0.40
USAR_GPU=false
# EASYOCR_DIR=modelos/easyocr   # modelos do EasyOCR pré-baixados (operação offline)
# EASYOCR_DOWNLOAD=false

# ===== Logs =====
LOG_DIR=logs
LOG_NIVEL=INFO
